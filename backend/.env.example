# ===== LLM API Key（请复制此文件为 .env 并填入真实 Key） =====
# 获取方式：https://platform.deepseek.com/api_keys
LLM_API_KEY=your_api_key_here

# 前端使用的 API Key（用于纯前端模式）
VITE_DEEPSEEK_API_KEY=your_api_key_here

# ===== 可选配置 =====
# LLM_PROVIDER=deepseek
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# DATABASE_URL=sqlite:///./learning_platform.db

# ===== 牛客实时题库（可选高级配置） =====
# 内置题库无需 Cookie；如需后端实时访问，可手工配置请求 Cookie。
# 请勿把真实 Cookie 提交到版本库。
NOWCODER_COOKIE=

# ===== Problem media cache (secure image proxy) =====
# No environment setting is required. Images are stored as SQLite blobs.
# Security limits are intentionally not configurable here: official exact-host allowlists,
# HTTPS port 443 only, static PNG/JPEG/WebP only, and a fixed 5 MiB response cap.
